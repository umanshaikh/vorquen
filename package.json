{
  "name": "fashionhub",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Fashion Ecommerce Platform for India (Direct-to-Consumer)",
  "scripts": {
    "dev": "next dev",
    "dev:storefront": "pnpm --filter vorquen-storefront web",
    "dev:admin": "pnpm --filter vorquen-admin web",
    "start:storefront": "pnpm --filter vorquen-storefront start",
    "start:admin": "pnpm --filter vorquen-admin start",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts || npx tsx prisma/seed.ts",
    "setup:owner": "tsx scripts/setup-owner.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "nodemailer": "^10.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
