# ========================================================
# FASHIONHUB ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials
# ========================================================

# Database Configuration
# Local SQLite (Development):
# DATABASE_URL="file:./dev.db"

# Supabase / PostgreSQL (Production):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Authentication & Session Security
JWT_SECRET="your-strong-random-jwt-secret-min-32-chars"
SESSION_COOKIE_NAME="fashionhub_session"

# Application URL
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_STORE_NAME="FashionHub"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# Razorpay Payment Gateway (India)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Shiprocket Courier Aggregator (India)
SHIPROCKET_API_EMAIL="shiprocket-login@email.com"
SHIPROCKET_API_PASSWORD="shiprocket-password"
SHIPROCKET_API_TOKEN=""

# Email Notifications (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="orders@yourdomain.com"
